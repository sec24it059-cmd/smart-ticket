# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=ticketnest-production-ready-jwt-secret-key-32chars
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration (Prisma ORM)
DATABASE_URL=postgresql://ticketnest_user:ticketnest_secure_pass@localhost:5432/ticketnest_db?schema=public

# Redis & BullMQ Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Ticket Reservation Engine
RESERVATION_EXPIRY_MINUTES=10
CLEANUP_INTERVAL_SECONDS=10

# Simulated Payment Gateway Settings
SIMULATED_PAYMENT_LATENCY_MS=1200

# Gemini API
GEMINI_API_KEY="MY_GEMINI_API_KEY"

